# Homebrew formula for the paxel/tap tap — generated by the release workflow,
# which fills in the tagged version and the sha256 of each release tarball and
# pushes the result to the homebrew-tap repository as Formula/dedup.rb.
# Binary formula: it installs the prebuilt `dedup`.
class Dedup < Formula
  desc "Forensic data-inheritance triage: dedupe, diff and browse file piles"
  homepage "https://github.com/paxel/dedup-rs"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/paxel/dedup-rs/releases/download/v{{VERSION}}/dedup-{{VERSION}}-macos-arm64.tar.gz"
      sha256 "{{SHA_MACOS_ARM64}}"
    else
      url "https://github.com/paxel/dedup-rs/releases/download/v{{VERSION}}/dedup-{{VERSION}}-macos-x86_64.tar.gz"
      sha256 "{{SHA_MACOS_X86_64}}"
    end
  end

  on_linux do
    url "https://github.com/paxel/dedup-rs/releases/download/v{{VERSION}}/dedup-{{VERSION}}-linux-x86_64.tar.gz"
    sha256 "{{SHA_LINUX_X86_64}}"
  end

  def install
    bin.install "dedup"
  end

  def caveats
    <<~EOS
      Optional tools unlock extra features (the app works without them):
        ffmpeg       — video previews, filmstrips, soundtrack playback
        poppler      — PDF page rendering (Render tab)
        libreoffice  — office/legacy document page rendering
    EOS
  end

  test do
    system "#{bin}/dedup", "--help"
  end
end
